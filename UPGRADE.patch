+.factor-list article {
+  display: flex;
+  gap: 24px;
+  justify-content: space-between;
+  padding: 16px 0;
+  border-top: 1px solid #eee;
+}
+.factor-list article > strong {
+  font-size: 24px;
+}
+.factor-list article div {
+  min-width: 0;
+}
+.factor-list p {
+  overflow-wrap: anywhere;
+}
+.knowledge-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 30px;
+}
+.report-section ul {
+  padding-left: 18px;
+  list-style: disc;
+}
+.report-section li {
+  font-size: 13px;
+  line-height: 1.7;
+  color: #555;
+  margin-bottom: 12px;
+}
+.report-section details {
+  padding: 16px 0;
+  border-bottom: 1px solid #eee;
+  font-size: 14px;
+}
+.report-section summary {
+  cursor: pointer;
+  min-height: 44px;
+  display: list-item;
+  padding-top: 10px;
+}
+.report-section a {
+  display: inline-block;
+  color: #111;
+  text-decoration: underline;
+  overflow-wrap: anywhere;
+  margin-top: 12px;
+  min-height: 44px;
+}
+.result-actions {
+  display: flex;
+  gap: 16px;
+  margin-top: 30px;
+}
+@media (max-width: 700px) {
+  .demo-container {
+    padding: 30px 20px 48px;
+  }
+  .analysis-form {
+    grid-template-columns: 1fr;
+    gap: 22px;
+  }
+  .analysis-form > .primary-button {
+    width: 100%;
+  }
+  .result-heading {
+    display: block;
+  }
+  .result-heading .secondary-button {
+    margin-bottom: 24px;
+  }
+  .score-strip {
+    grid-template-columns: 1fr 1fr;
+    gap: 24px;
+  }
+  .score-strip > :last-child {
+    grid-column: 1/-1;
+  }
+  .signal-grid,
+  .knowledge-grid {
+    grid-template-columns: 1fr;
+  }
+  .result-actions {
+    flex-direction: column;
+  }
+  .demo-header {
+    padding: 0 20px;
+  }
+  .demo-header a {
+    font-size: 12px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation: none !important;
+    transition: none !important;
+    scroll-behavior: auto !important;
+  }
+}

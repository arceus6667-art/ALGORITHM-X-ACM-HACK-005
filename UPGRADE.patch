+import { analyzeFile } from "./services/FileAnalyzer";
+process.once(
+  "message",
+  async (input: { bytes: Buffer; name: string; mime: string }) => {
+    try {
+      const result = await analyzeFile(input.bytes, input.name, input.mime);
+      process.send?.({ result }, () => process.exit(0));
+    } catch {
+      process.send?.(

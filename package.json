{
  "name": "agenttrap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "vite build",
    "preview": "node --import tsx scripts/start.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "start": "node --import tsx scripts/start.mjs",
    "test": "node --import tsx --test tests/api.test.ts tests/services.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests scripts *.ts *.json *.md platform-policies",
    "test:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.34.0",
    "vite": "^8.3.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^2.10.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

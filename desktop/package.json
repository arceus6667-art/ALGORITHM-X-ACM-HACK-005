{
  "name": "agenttrap-desktop",
  "version": "0.1.1",
  "description": "Local AgentTrap CRM hackathon evaluation",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "portable": "node launch.mjs",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.agenttrap.crm",
    "productName": "AgentTrap CRM",
    "asar": true,
    "files": [
      "main.cjs",
      "server.mjs",
      "launch.mjs",
      "edition.json",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "AgentTrap-${version}-${os}-${arch}-${env.AGENTTRAP_EDITION}.${ext}",
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
